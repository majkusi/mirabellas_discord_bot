# Copy to .env and fill in. Never commit .env.

# Discord (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=
# Test server ID for instant slash command sync during development (optional)
DISCORD_GUILD_ID=

# Primary LLM provider (OpenAI-compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
LLM_API_KEY=

# Fallback LLM provider, used on HTTP 429 or timeout
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
